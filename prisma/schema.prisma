generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model Tenant {
  id                      String                   @id @default(uuid()) @db.Uuid
  companyName             String                   @map("company_name")
  adminEmail              String                   @map("admin_email")
  isActive                Boolean                  @default(true) @map("is_active")
  subscriptionStart       DateTime?                @map("subscription_start")
  subscriptionEnd         DateTime?                @map("subscription_end")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  logoUrl                 String?                  @map("logo_url")
  logoDarkUrl             String?                  @map("logo_dark_url")
  attendanceConfigs       AttendanceConfig[]
  attendances             Attendance[]
  overtimeConfigs         OvertimeConfig[]
  overtimeApproverConfigs OvertimeApproverConfig[]
  overtimes               Overtime[]
  payrollComponentConfigs PayrollComponentConfig[]
  departments             Department[]
  branches                Branch[]
  workShifts              WorkShift[]
  employeeShiftSchedules  EmployeeShiftSchedule[]
  leaveConfigs            LeaveConfig[]
  payrolls                Payroll[]
  performances            Performance[]
  reimbursements          Reimbursement[]
  roles                   Role[]
  submissionTypes         SubmissionType[]
  submissions             Submission[]
  pettyCashes             PettyCash[]
  accounts                Account[]
  accountCategories       AccountCategory[]
  banks                   Bank[]
  customers               Customer[]
  vendors                 Vendor[]
  taskBoards              TaskBoard[]
  tasks                   Task[]
  users                   User[]

  @@map("tenants")
}

model Role {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  permission Json
  tenantId   String? @map("tenant_id") @db.Uuid
  tenant     Tenant? @relation(fields: [tenantId], references: [id])
  users      User[]

  @@index([tenantId])
  @@map("roles")
}

model Department {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  tenantId       String?        @map("tenant_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  taskBoards     TaskBoard[]
  taskCategories TaskCategory[]
  tasks          Task[]
  users          User[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@index([branchId])
  @@map("departments")
}

model Branch {
  id                        String                  @id @default(uuid()) @db.Uuid
  tenantId                  String                  @map("tenant_id") @db.Uuid
  name                      String
  code                      String?
  address                   String?
  latitude                  Float
  longitude                 Float
  attendanceRadiusMeters    Int                     @default(100) @map("attendance_radius_meters")
  locationLockEnabled       Boolean                 @default(false) @map("location_lock_enabled")
  customWorkingHoursEnabled Boolean                 @default(true) @map("custom_working_hours_enabled")
  scheduleType              String                  @default("REGULAR") @map("schedule_type")
  officeStartTime           String                  @default("09:00") @map("office_start_time")
  officeEndTime             String                  @default("17:00") @map("office_end_time")
  isActive                  Boolean                 @default(true) @map("is_active")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                     User[]
  attendances               Attendance[]
  departments               Department[]
  workingSchedules          BranchWorkingSchedule[]
  workShifts                WorkShift[]
  employeeShiftSchedules    EmployeeShiftSchedule[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  roleId                      String                       @map("role_id") @db.Uuid
  departmentId                String?                      @map("department_id") @db.Uuid
  branchId                    String?                      @map("branch_id") @db.Uuid
  email                       String                       @unique
  name                        String
  nik                         String?
  phone                       String?
  position                    String?
  joinDate                    DateTime?                    @map("join_date")
  salary                      Float?
  salaryType                  String                       @default("monthly") @map("salary_type")
  avatarUrl                   String?                      @map("avatar_url")
  faceDescriptor              Json?                        @map("face_descriptor")
  password                    String
  currentToken                String?                      @map("current_token")
  salt                        String
  status                      String                       @default("active")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  tenantId                    String?                      @map("tenant_id") @db.Uuid
  address                     String?
  birthDate                   DateTime?                    @map("birth_date")
  birthPlace                  String?                      @map("birth_place")
  gender                      String?
  attendances                 Attendance[]
  overtimes                   Overtime[]
  overtimeApprovalDecisions   OvertimeApprovalDecision[]   @relation("overtime_decision_user")
  overtimeApproverConfigs     OvertimeApproverConfig[]     @relation("overtime_approver_user")
  payrolls                    Payroll[]
  performances                Performance[]
  pettyCashes                 PettyCash[]
  reimbursements              Reimbursement[]
  submissionApprovalDecisions SubmissionApprovalDecision[] @relation("submission_decision_user")
  submissionApproverConfigs   SubmissionApproverConfig[]   @relation("submission_approver_user")
  submissions                 Submission[]
  taskMembers                 TaskMember[]
  createdTasks                Task[]                       @relation("task_creator")
  journalEntries              Journal[]                    @relation("journal_creator")
  department                  Department?                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  branch                      Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role                        Role                         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant                      Tenant?                      @relation(fields: [tenantId], references: [id])
  employeeShiftSchedules      EmployeeShiftSchedule[]

  @@index([tenantId])
  @@map("users")
}

model SubmissionType {
  id              String                     @id @default(uuid()) @db.Uuid
  name            String
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  deletedAt       DateTime?                  @map("deleted_at")
  leaveConfigId   String?                    @map("leave_config_id") @db.Uuid
  tenantId        String?                    @map("tenant_id") @db.Uuid
  approverConfigs SubmissionApproverConfig[]
  leaveConfig     LeaveConfig?               @relation(fields: [leaveConfigId], references: [id])
  tenant          Tenant?                    @relation(fields: [tenantId], references: [id])
  submissions     Submission[]

  @@index([tenantId])
  @@map("submission_types")
}

model SubmissionApproverConfig {
  id               String         @id @default(uuid()) @db.Uuid
  submissionTypeId String         @map("submission_type_id") @db.Uuid
  approverUserId   String         @map("approver_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  approverUser     User           @relation("submission_approver_user", fields: [approverUserId], references: [id], onDelete: Cascade)
  submissionType   SubmissionType @relation(fields: [submissionTypeId], references: [id], onDelete: Cascade)

  @@unique([submissionTypeId, approverUserId])
  @@index([submissionTypeId])
  @@map("submission_approver_configs")
}

model LeaveConfig {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  maxDays         Int              @map("max_days")
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tenantId        String?          @map("tenant_id") @db.Uuid
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  submissionTypes SubmissionType[]

  @@index([tenantId])
  @@map("leave_configs")
}

model Submission {
  id                String                       @id @default(uuid()) @db.Uuid
  userId            String                       @map("user_id") @db.Uuid
  submissionTypeId  String                       @map("submission_type_id") @db.Uuid
  startDate         DateTime                     @map("start_date")
  endDate           DateTime                     @map("end_date")
  reason            String
  proofUrl          String?                      @map("proof_url")
  status            String                       @default("pending")
  approvedBy        String?                      @map("approved_by")
  approvedAt        DateTime?                    @map("approved_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  deletedAt         DateTime?                    @map("deleted_at")
  tenantId          String?                      @map("tenant_id") @db.Uuid
  approvalDecisions SubmissionApprovalDecision[]
  submissionType    SubmissionType               @relation(fields: [submissionTypeId], references: [id], onDelete: Cascade)
  tenant            Tenant?                      @relation(fields: [tenantId], references: [id])
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("submissions")
}

model SubmissionApprovalDecision {
  id             String     @id @default(uuid()) @db.Uuid
  submissionId   String     @map("submission_id") @db.Uuid
  approverUserId String     @map("approver_user_id") @db.Uuid
  status         String     @default("PENDING")
  reason         String?
  decidedAt      DateTime?  @map("decided_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  approverUser   User       @relation("submission_decision_user", fields: [approverUserId], references: [id], onDelete: Cascade)
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, approverUserId])
  @@index([submissionId])
  @@map("submission_approval_decisions")
}

model Attendance {
  id                     String     @id @default(uuid()) @db.Uuid
  userId                 String     @map("user_id") @db.Uuid
  date                   DateTime
  attendanceDay          DateTime   @map("attendance_day")
  checkIn                DateTime?  @map("check_in")
  checkOut               DateTime?  @map("check_out")
  autoCheckout           Boolean    @default(false) @map("auto_checkout")
  breakSessions          Json?      @map("break_sessions")
  breakDuration          String?    @map("break_duration")
  status                 String
  notes                  String?
  workHours              String?    @map("work_hours")
  checkInLocation        Json?      @map("check_in_location")
  checkOutLocation       Json?      @map("check_out_location")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  checkInFaceImage       String?    @map("check_in_face_image")
  checkOutFaceImage      String?    @map("check_out_face_image")
  tenantId               String?    @map("tenant_id") @db.Uuid
  branchId               String?    @map("branch_id") @db.Uuid
  workShiftId            String?    @map("work_shift_id") @db.Uuid
  scheduledStartAt       DateTime?  @map("scheduled_start_at")
  scheduledEndAt         DateTime?  @map("scheduled_end_at")
  scheduleSource         String?    @map("schedule_source")
  checkInDistanceMeters  Float?     @map("check_in_distance_meters")
  checkOutDistanceMeters Float?     @map("check_out_distance_meters")
  overtime               Overtime?
  tenant                 Tenant?    @relation(fields: [tenantId], references: [id])
  branch                 Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workShift              WorkShift? @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attendanceDay])
  @@index([tenantId])
  @@index([branchId])
  @@index([workShiftId])
  @@map("attendances")
}

model BranchWorkingSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  dayOfWeek String   @map("day_of_week")
  isWorkDay Boolean  @default(true) @map("is_work_day")
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
  @@map("branch_working_schedules")
}

model WorkShift {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  branchId             String                  @map("branch_id") @db.Uuid
  name                 String
  code                 String?
  startTime            String                  @map("start_time")
  endTime              String                  @map("end_time")
  crossesMidnight      Boolean                 @default(false) @map("crosses_midnight")
  lateToleranceMinutes Int?                    @map("late_tolerance_minutes")
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules            EmployeeShiftSchedule[]
  attendances          Attendance[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@index([tenantId])
  @@index([branchId])
  @@map("work_shifts")
}

model EmployeeShiftSchedule {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  shiftId   String?    @map("shift_id") @db.Uuid
  isDayOff  Boolean    @default(false) @map("is_day_off")
  workDate  DateTime   @map("work_date") @db.Date
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift     WorkShift? @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([tenantId, workDate])
  @@index([branchId, workDate])
  @@index([shiftId])
  @@map("employee_shift_schedules")
}

model AttendanceConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  officeStartTime         String   @map("office_start_time")
  officeEndTime           String   @map("office_end_time")
  lateToleranceMinutes    Int      @map("late_tolerance_minutes")
  lateDeductionAmount     Float    @default(0) @map("late_deduction_amount")
  overtimeThresholdHours  Float    @default(2) @map("overtime_threshold_hours")
  breakEnabled            Boolean  @default(false) @map("break_enabled")
  breakFaceCaptureEnabled Boolean  @default(false) @map("break_face_capture_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  tenantId                String?  @map("tenant_id") @db.Uuid
  workingDays             String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]) @map("working_days")
  tenant                  Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("attendance_configs")
}

model OvertimeConfig {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  payMethod  String   @default("PER_HOUR") @map("pay_method")
  hourlyRate Float    @default(0) @map("hourly_rate")
  dailyRate  Float    @default(0) @map("daily_rate")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("overtime_configs")
}

model OvertimeApproverConfig {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  approverUserId String   @map("approver_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  approverUser   User     @relation("overtime_approver_user", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, approverUserId])
  @@index([tenantId])
  @@map("overtime_approver_configs")
}

model Overtime {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String?                    @map("tenant_id") @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  attendanceId      String?                    @map("attendance_id") @db.Uuid
  overtimeDate      DateTime                   @map("overtime_date")
  startTime         DateTime?                  @map("start_time")
  endTime           DateTime?                  @map("end_time")
  overtimeMinutes   Int                        @default(0) @map("overtime_minutes")
  requestedMinutes  Int                        @default(0) @map("requested_minutes")
  description       String?
  proofUrl          String?                    @map("proof_url")
  checkInLocation   Json?                      @map("check_in_location")
  checkOutLocation  Json?                      @map("check_out_location")
  checkInFaceImage  String?                    @map("check_in_face_image")
  checkOutFaceImage String?                    @map("check_out_face_image")
  rejectReason      String?                    @map("reject_reason")
  payMethod         String                     @map("pay_method")
  hourlyRate        Float                      @map("hourly_rate")
  dailyRate         Float                      @map("daily_rate")
  payoutAmount      Float                      @map("payout_amount")
  status            String                     @default("PENDING")
  approvedBy        String?                    @map("approved_by")
  approvedAt        DateTime?                  @map("approved_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  approvalDecisions OvertimeApprovalDecision[]
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance        Attendance?                @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  tenant            Tenant?                    @relation(fields: [tenantId], references: [id])

  @@unique([attendanceId])
  @@index([tenantId])
  @@index([userId, overtimeDate])
  @@map("overtimes")
}

model OvertimeApprovalDecision {
  id             String    @id @default(uuid()) @db.Uuid
  overtimeId     String    @map("overtime_id") @db.Uuid
  approverUserId String    @map("approver_user_id") @db.Uuid
  status         String    @default("PENDING")
  reason         String?
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  approverUser   User      @relation("overtime_decision_user", fields: [approverUserId], references: [id], onDelete: Cascade)
  overtime       Overtime  @relation(fields: [overtimeId], references: [id], onDelete: Cascade)

  @@unique([overtimeId, approverUserId])
  @@index([overtimeId])
  @@map("overtime_approval_decisions")
}

model Payroll {
  id                  String                  @id @default(uuid()) @db.Uuid
  userId              String                  @map("user_id") @db.Uuid
  referenceNumber     String?                 @map("reference_number")
  month               Int
  year                Int
  basicSalary         Float                   @map("basic_salary")
  salaryType          String                  @default("monthly") @map("salary_type")
  salaryRate          Float                   @default(0) @map("salary_rate")
  paidAttendanceDays  Int                     @default(0) @map("paid_attendance_days")
  lateDeductionRate   Float                   @default(0) @map("late_deduction_rate")
  lateAttendanceDays  Int                     @default(0) @map("late_attendance_days")
  lateDeductionAmount Float                   @default(0) @map("late_deduction_amount")
  allowances          Float                   @default(0)
  deductions          Float                   @default(0)
  totalSalary         Float                   @map("total_salary")
  status              String                  @default("pending")
  paidAt              DateTime?               @map("paid_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")
  tenantId            String?                 @map("tenant_id") @db.Uuid
  componentValues     PayrollComponentValue[]
  tenant              Tenant?                 @relation(fields: [tenantId], references: [id])
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([referenceNumber])
  @@map("payrolls")
}

model PayrollComponentConfig {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String?                 @map("tenant_id") @db.Uuid
  name            String
  type            String
  inputType       String                  @map("input_type")
  defaultValue    Float                   @default(0) @map("default_value")
  isActive        Boolean                 @default(true) @map("is_active")
  sortOrder       Int                     @default(0) @map("sort_order")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  tenant          Tenant?                 @relation(fields: [tenantId], references: [id])
  componentValues PayrollComponentValue[]

  @@index([tenantId])
  @@index([type])
  @@map("payroll_component_configs")
}

model PayrollComponentValue {
  id                String                  @id @default(uuid()) @db.Uuid
  payrollId         String                  @map("payroll_id") @db.Uuid
  componentConfigId String?                 @map("component_config_id") @db.Uuid
  nameSnapshot      String                  @map("name_snapshot")
  typeSnapshot      String                  @map("type_snapshot")
  inputTypeSnapshot String                  @map("input_type_snapshot")
  amount            Float
  baseValue         Float?                  @map("base_value")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  componentConfig   PayrollComponentConfig? @relation(fields: [componentConfigId], references: [id], onDelete: SetNull)
  payroll           Payroll                 @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([componentConfigId])
  @@index([typeSnapshot])
  @@map("payroll_component_values")
}

model Performance {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  period       String
  productivity Int
  quality      Int
  teamwork     Int
  discipline   Int
  totalScore   Float     @map("total_score")
  notes        String?
  evaluatedBy  String    @map("evaluated_by")
  evaluatedAt  DateTime  @map("evaluated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  tenantId     String?   @map("tenant_id") @db.Uuid
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("performances")
}

model Reimbursement {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  referenceNumber String?   @map("reference_number")
  title           String
  category        String
  amount          Float
  date            DateTime
  bankName        String?   @map("bank_name")
  accountNumber   String?   @map("account_number")
  description     String?
  receiptUrl      String?   @map("receipt_url")
  status          String    @default("pending")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenantId        String?   @map("tenant_id") @db.Uuid
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  details         ReimbursementDetail[]

  @@index([tenantId])
  @@index([userId])
  @@index([referenceNumber])
  @@map("reimbursements")
}

model ReimbursementDetail {
  id              String        @id @default(uuid()) @db.Uuid
  reimbursementId String        @map("reimbursement_id") @db.Uuid
  position        Int
  category        String
  amount          Float
  date            DateTime
  receiptUrl      String?       @map("receipt_url")
  receiptUrls     String[]      @default([]) @map("receipt_urls")
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@unique([reimbursementId, position])
  @@map("reimbursement_details")
}

model PettyCash {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  purpose       String
  category      String
  amount        Float
  transferDate  DateTime?        @map("transfer_date")
  bankName      String           @map("bank_name")
  accountNumber String           @map("account_number")
  status        String           @default("PENDING")
  createdBy     String?          @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  tenantId      String?          @map("tenant_id") @db.Uuid
  usages        PettyCashUsage[]
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("petty_cashes")
}

model PettyCashUsage {
  id          String    @id @default(uuid()) @db.Uuid
  pettyCashId String    @map("petty_cash_id") @db.Uuid
  description String
  amount      Float
  usageDate   DateTime  @map("usage_date")
  receiptUrl  String?   @map("receipt_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  pettyCash   PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)

  @@index([pettyCashId])
  @@map("petty_cash_usages")
}

model AccountCategory {
  id       String    @id @default(uuid()) @db.Uuid
  code     String
  name     String
  tenantId String?   @map("tenant_id") @db.Uuid
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  accounts Account[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("account_categories")
}

model Account {
  id                String          @id @default(uuid()) @db.Uuid
  accountCategoryId String          @map("account_category_id") @db.Uuid
  parentId          String?         @map("parent_id") @db.Uuid
  code              String
  name              String
  normalBalance     NormalBalance   @map("normal_balance")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  tenantId          String?         @map("tenant_id") @db.Uuid
  tenant            Tenant?         @relation(fields: [tenantId], references: [id])
  accountCategory   AccountCategory @relation(fields: [accountCategoryId], references: [id], onDelete: Cascade)
  parent            Account?        @relation("AccountParent", fields: [parentId], references: [id])
  children          Account[]       @relation("AccountParent")
  banks             Bank[]
  journalDetails    JournalDetail[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([accountCategoryId])
  @@index([parentId])
  @@map("accounts")
}

model Journal {
  id          String          @id @default(uuid()) @db.Uuid
  journalNo   String          @map("journal_no")
  date        DateTime
  referenceNo String?         @map("reference_no")
  description String?
  createdBy   String?         @map("created_by") @db.Uuid
  status      JournalStatus   @default(DRAFT)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  creator     User?           @relation("journal_creator", fields: [createdBy], references: [id], onDelete: SetNull)
  details     JournalDetail[]

  @@unique([journalNo])
  @@index([createdBy])
  @@index([date])
  @@map("journals")
}

model JournalDetail {
  id          String    @id @default(uuid()) @db.Uuid
  journalId   String    @map("journal_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  debit       Float     @default(0)
  credit      Float     @default(0)
  description String?
  customerId  String?   @map("customer_id") @db.Uuid
  vendorId    String?   @map("vendor_id") @db.Uuid
  journal     Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([accountId])
  @@index([customerId])
  @@index([vendorId])
  @@map("journal_details")
}

model Customer {
  id       String          @id @default(uuid()) @db.Uuid
  code     String
  name     String
  phone    String?
  email    String?
  address  String?
  tenantId String?         @map("tenant_id") @db.Uuid
  tenant   Tenant?         @relation(fields: [tenantId], references: [id])
  journals JournalDetail[]

  @@unique([tenantId, code])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

model Vendor {
  id       String          @id @default(uuid()) @db.Uuid
  code     String
  name     String
  phone    String?
  email    String?
  address  String?
  tenantId String?         @map("tenant_id") @db.Uuid
  tenant   Tenant?         @relation(fields: [tenantId], references: [id])
  journals JournalDetail[]

  @@unique([tenantId, code])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("vendors")
}

model Bank {
  id            String  @id @default(uuid()) @db.Uuid
  accountId     String  @map("account_id") @db.Uuid
  bankName      String  @map("bank_name")
  accountNumber String  @map("account_number")
  accountHolder String  @map("account_holder")
  tenantId      String? @map("tenant_id") @db.Uuid
  tenant        Tenant? @relation(fields: [tenantId], references: [id])
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([accountId])
  @@map("banks")
}

model TaskBoard {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  name         String
  description  String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  tenantId     String?    @map("tenant_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  lists        TaskList[]

  @@index([departmentId])
  @@index([tenantId])
  @@map("task_boards")
}

model TaskDoneMovePermission {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@map("task_done_move_permissions")
}

model TaskList {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  boardId   String    @map("board_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  board     TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
  @@map("task_lists")
}

model Task {
  id           String               @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  dueDate      DateTime?            @map("due_date")
  position     Int                  @default(0)
  listId       String               @map("list_id") @db.Uuid
  departmentId String               @map("department_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  tenantId     String?              @map("tenant_id") @db.Uuid
  createdById  String               @map("created_by_id") @db.Uuid
  deletedAt    DateTime?            @map("deleted_at")
  startDate    DateTime             @map("start_date")
  attachments  TaskAttachment[]
  categories   TaskCategoryOnTask[]
  members      TaskMember[]
  createdBy    User                 @relation("task_creator", fields: [createdById], references: [id], onDelete: Cascade)
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  list         TaskList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  tenant       Tenant?              @relation(fields: [tenantId], references: [id])

  @@index([listId])
  @@index([departmentId])
  @@index([createdById])
  @@index([tenantId])
  @@map("tasks")
}

model TaskCategory {
  id           String               @id @default(uuid()) @db.Uuid
  departmentId String               @map("department_id") @db.Uuid
  name         String
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  taskLinks    TaskCategoryOnTask[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("task_categories")
}

model TaskCategoryOnTask {
  id         String       @id @default(uuid()) @db.Uuid
  taskId     String       @map("task_id") @db.Uuid
  categoryId String       @map("category_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  category   TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, categoryId])
  @@index([taskId])
  @@index([categoryId])
  @@map("task_category_on_tasks")
}

model TaskMember {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_members")
}

model TaskAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  name      String?
  url       String
  objectKey String?  @map("object_key")
  type      String?
  createdAt DateTime @default(now()) @map("created_at")
  size      Int?
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}
